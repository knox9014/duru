{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "duru",
  "version": "0.2.0",
  "identifier": "com.duru.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "두루",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QTdCNkE1QjA4RjE0RjIKUldUeUZJK3dwYmFudGw2Y1M2K2VyZXF2cjM2Y0ZDamNTakV3L2tYaStRTEhOTys4RndqZE5iMVYK",
      "endpoints": [
        "https://github.com/knox9014/duru/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
